# Copy to .env and fill in your Appwrite project details.
# Find these in your Appwrite Console → your project → Settings.

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id-here
VITE_APPWRITE_DATABASE_ID=task-manager-db

# Only needed for the one-time setup script (npm run setup).
# Use your Appwrite API key with full database permissions.
# Do NOT commit this value — it stays local only.
APPWRITE_API_KEY=your-api-key-here
